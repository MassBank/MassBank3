FROM docker.io/golang:1.27.3 AS build
WORKDIR /go/src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg/mb3dbtool/main.go ./cmd/mb3dbtool/
COPY pkg/ ./pkg

ENV CGO_ENABLED=0
RUN go build -mod=readonly -a -installsuffix cgo -o mb3dbtool ./cmd/mb3dbtool

FROM docker.io/alpine:3.21 AS runtime
COPY --from=build /go/src/mb3dbtool ./
RUN printf 'case $MB_DB_INIT in\n\
  true) echo Initialize database...\n\
  ./mb3dbtool;;\n\
  *) echo Skip database initialization...;;\n\
  esac' > ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

EXPOSE 8080/tcp
CMD ["/bin/sh","./entrypoint.sh"]
