{
  "name": "MassBank3 Go and Frontend Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/MassBank3",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/MassBank3,type=bind,Z",
  "mounts": [
    "source=massbank3-go,target=/go/pkg,type=volume",
    "source=massbank3-npm,target=/home/vscode/.npm,type=volume",
    "source=codex-devcontainer,target=/home/vscode/.codex,type=volume",
    "source=copilot-devcontainer,target=/home/vscode/.copilot,type=volume",
    "source=copilot-auth-devcontainer,target=/home/vscode/.config/github-copilot,type=volume",
    "source=${localWorkspaceFolder}/../MassBank-similarity-api,target=/workspaces/MassBank-similarity-api,type=bind,Z",
    "source=${localWorkspaceFolder}/../MassBank-lib,target=/workspaces/MassBank-lib,type=bind,Z",
    "source=${localWorkspaceFolder}/../MassBank-export-api,target=/workspaces/MassBank-export-api,type=bind,Z",
    "source=${localWorkspaceFolder}/../MassBank-data,target=/workspaces/MassBank-data,type=bind,Z"
  ],
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--security-opt=label=disable"
  ],
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "GOPATH": "/go",
    "GOBIN": "/go/bin"
  },
  "forwardPorts": [3000, 8080, 8081, 5432, 40000],
  "portsAttributes": {
    "3000": { "label": "MassBank frontend", "onAutoForward": "notify" },
    "8080": { "label": "MassBank API", "onAutoForward": "notify" },
    "8081": { "label": "MassBank API (alternate)", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "40000": { "label": "Delve debugger", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "jetbrains": {
      "settings": {
        "com.intellij:app:HttpConfigurable.use_proxy_pac": true
      }
    },
    "vscode": {
      "extensions": [

      ],
      "settings": {

      }
    }
  }
}
